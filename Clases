package clases;

public class Vehiculo {

	private int velocidad;
	private float capacidad;
	private String placa;
	
	private Vehiculo (int velocidad, float capacidad, String placa) {
		this.velocidad = velocidad;
		this.capacidad = capacidad;
		this.placa = placa;
	}
	
	private int SetVelocidad() {
		return velocidad;
	}

	private int GetVelocidad() {
		return velocidad;
	}
	
	private float SetCapacidad() {
		return capacidad;
	}

	private float GetCapacidad() {
		return capacidad;
	}
	
	private String SetPlaca() {
		return placa;
	}
	
	private String GetPlaca() {
		return placa;
	}
	
